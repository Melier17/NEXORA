{
  "name": "melier17/nexora-backend",
  "description": "NEXORA REST API built with PHP and MySQL",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Config\\": "config/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
